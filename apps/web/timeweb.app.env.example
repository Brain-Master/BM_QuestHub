NEXT_PUBLIC_LEAD_SUBMIT_URL=https://functions.yandexcloud.net/d4ellekng389grh5rck4
NEXT_PUBLIC_OPS_REPORT_URL=https://functions.yandexcloud.net/d4eugco206uh65ivpbtm
