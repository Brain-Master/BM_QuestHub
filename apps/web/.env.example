# Канонический origin для Open Graph / metadataBase (прод-домен сайта каталога)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Публичный счётчик Яндекс.Метрики (client-side)
NEXT_PUBLIC_YM_ID=

# Опционально: URL webhook для заявок (JSON POST тело как в форме)
LEAD_WEBHOOK_URL=

# --- Синхронизация смен из приватной Google Таблицы (POST /api/internal/sync-offers) ---
# Секрет для заголовка Authorization: Bearer …
SYNC_OFFERS_SECRET=
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Диапазон (по умолчанию первый лист A:Z). Пример с именем листа: %27Лист1%27!A:Z
GOOGLE_SHEETS_RANGE=
# JSON сервисного аккаунта (одна строка). Содержимое скачанного ключа — в одну строку для .env
GOOGLE_SERVICE_ACCOUNT_JSON=
# Алерты при ошибке синка (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Переопределить путь к снимку (по умолчанию apps/web/data/offers-snapshot.json)
OFFERS_SNAPSHOT_PATH=
