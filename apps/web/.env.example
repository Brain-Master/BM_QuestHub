# Канонический origin для Open Graph / metadataBase (прод-домен сайта курсов)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Публичный счётчик Яндекс.Метрики (client-side)
NEXT_PUBLIC_YM_ID=109320888

# Публичный продовый приёмник заявок: сайт отправляет только сюда.
# Яндекс уже server-side уведомляет Telegram, пишет в Google Sheet и опционально форвардит в n8n.
# Пример (bm-lead-receiver): https://functions.yandexcloud.net/d4ellekng389grh5rck4
NEXT_PUBLIC_LEAD_SUBMIT_URL=

# Ops-reporter: fire-and-forget client error reports (Yandex Function bm-lead-ops-reporter).
NEXT_PUBLIC_OPS_REPORT_URL=

# Публичная база Object Storage / CDN (медиа, JSON в ссылках, build-time fetch).
# Timeweb: https://<bucket>.s3.twcstorage.ru
# Legacy Yandex: https://storage.yandexcloud.net/<bucket>
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

# --- Build-time: чтение снимков с S3 (без секретов; объекты публично читаемы) ---
# Расписание V1: data/offers-snapshot.json
OFFERS_SNAPSHOT_SOURCE=
OFFERS_SNAPSHOT_URL=
# Переопределить локальный путь (по умолчанию apps/web/data/offers-snapshot.json)
OFFERS_SNAPSHOT_PATH=

# Site V2: data/v2/site-manifest.json (+ site-config, schedule-snapshot по манифесту)
SITE_SNAPSHOT_SOURCE=
SITE_SNAPSHOT_MANIFEST_URL=
SITE_SNAPSHOT_MANIFEST_PATH=
# SITE_SNAPSHOT_STRICT=1 — падать при пустом расписании

# --- Google Sheets editor UI (см. docs/data/google-sheets-editor-guide.md) ---
# Hot — расписание: https://docs.google.com/spreadsheets/d/1ut5AhfJqx9wrJE3tTCzrkrQdCmWsCPB8cueHH3QsLy8
GOOGLE_SHEETS_HOT_SPREADSHEET_ID=1ut5AhfJqx9wrJE3tTCzrkrQdCmWsCPB8cueHH3QsLy8
GOOGLE_SHEETS_HOT_RANGE_GROUPS='Группы'!A:AZ
GOOGLE_SHEETS_HOT_RANGE_FORMATS='Форматы'!A:AZ
# Cold — курсы/площадки/миры: https://docs.google.com/spreadsheets/d/1fqeVC8BhjGWtOR20NhCUQuhwgchkCCzYsmiudpGE4jc
GOOGLE_SHEETS_COLD_SPREADSHEET_ID=1fqeVC8BhjGWtOR20NhCUQuhwgchkCCzYsmiudpGE4jc
GOOGLE_SHEETS_COLD_RANGE_WORLDS='Миры'!A:Z
GOOGLE_SHEETS_COLD_RANGE_VENUES='Площадки'!A:Z
GOOGLE_SHEETS_COLD_RANGE_COURSES='Курсы'!A:Z
# Legacy aliases (hot)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=
# JSON сервисного аккаунта (одна строка). Share both spreadsheets with client_email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Секреты выкладки в бакет (make s3-sync-*) — scripts/s3.env, см. docs/deployment/timeweb-object-storage-setup.md
