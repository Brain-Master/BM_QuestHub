# Канонический origin для Open Graph / metadataBase (прод-домен сайта курсов)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Публичный счётчик Яндекс.Метрики (client-side)
NEXT_PUBLIC_YM_ID=

# Публичный продовый приёмник заявок: сайт отправляет только сюда.
# Яндекс уже server-side уведомляет Telegram, пишет в Google Sheet и опционально форвардит в n8n.
# Пример (bm-lead-receiver): https://functions.yandexcloud.net/d4ellekng389grh5rck4
NEXT_PUBLIC_LEAD_SUBMIT_URL=

# Публичная база для горячего S3/CDN с медиа и, при необходимости, JSON-данными.
# Пример: https://storage.yandexcloud.net/bm-questhub
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

# --- Локальная/CI синхронизация смен из приватной Google Таблицы ---
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Диапазон (по умолчанию первый лист A:Z). Пример с именем листа: %27Лист1%27!A:Z
GOOGLE_SHEETS_RANGE=
# JSON сервисного аккаунта (одна строка). Содержимое скачанного ключа — в одну строку для .env
GOOGLE_SERVICE_ACCOUNT_JSON=
# Переопределить путь к снимку (по умолчанию apps/web/data/offers-snapshot.json)
OFFERS_SNAPSHOT_PATH=
