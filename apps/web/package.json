{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "node ../../scripts/assert-port-free.mjs 3000 && next dev --hostname 0.0.0.0 --port 3000",
    "generate:host-aliases": "node ../../scripts/generate-host-aliases.mjs",
    "verify:s3": "node ../../scripts/verify-s3-snapshots.mjs",
    "build": "npm run generate:host-aliases && npm run verify:s3 && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test:host-scope": "node --test ../../scripts/host-alias-core.test.mjs",
    "test:e2e": "playwright test",
    "validate:snapshots": "node ../../scripts/validate-public-snapshot.mjs",
    "audit:hardcoded-data": "node ../../scripts/audit-hardcoded-data.mjs",
    "check": "npm run lint && npm run validate:snapshots && npm run audit:hardcoded-data && npm run test:host-scope && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
