# Comma-separated website origins that may submit browser requests.
# Timeweb App Platform production examples:
# https://quest.b-master.pro,https://b-master.pro,https://1517.b-master.pro
ALLOWED_ORIGINS=https://quest.b-master.pro

# Primary lead delivery: Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Primary lead delivery: append rows to a private Google Sheet.
# Service account JSON as one line. Share the spreadsheet with client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative for CLI deployment: base64url-encoded service account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Example: Leads!A:S
GOOGLE_LEADS_SHEET_RANGE=

# Optional best-effort automation copy. Failure here does not fail the lead.
N8N_WEBHOOK_URL=
N8N_TIMEOUT_MS=2500

# Optional ops alerts on 400/502 (bm-lead-ops-reporter URL + shared token).
OPS_REPORT_URL=
OPS_REPORT_TOKEN=
