# Comma-separated website origins allowed for browser reports (no X-Ops-Token).
ALLOWED_ORIGINS=https://quest.b-master.pro,https://1517.b-master.pro,http://localhost:3000

# Shared secret for server-to-server reports (bm-lead-receiver).
OPS_REPORT_TOKEN=

# Telegram ops alerts (can match lead chat or use a dedicated ops channel).
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Optional Google Sheet audit log (same spreadsheet as leads is fine).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Example: Ops!A:M (create tab: node scripts/setup-ops-sheet.mjs)
GOOGLE_OPS_SHEET_RANGE=Ops!A:M

# Client event dedupe window in ms (default 60000).
OPS_RATE_LIMIT_WINDOW_MS=60000
