# OAuth для Design Pack → личный Google Drive (copy → design-pack-oauth.env, gitignored)
#
# GCP: OAuth client type Desktop app, consent screen Testing + your Gmail as test user.
# Scope при login: https://www.googleapis.com/auth/drive

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Опционально: путь к token JSON (по умолчанию scripts/design-pack-oauth-token.json)
# GOOGLE_DRIVE_OAUTH_TOKEN_PATH=
