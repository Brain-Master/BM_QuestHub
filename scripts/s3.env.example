# Copy to scripts/s3.env (gitignored) or: node scripts/setup-s3-hot-env.mjs
# Hot bucket (active). Legacy cold: S3_LEGACY_BUCKET — see docs/deployment/s3-storage-migration.md

S3_STORAGE_PROFILE=hot
S3_BUCKET=bm-quest-s3-hot
S3_LEGACY_BUCKET=bm-questhub
S3_PUBLIC_BASE_URL=https://bm-quest-s3-hot.s3.twcstorage.ru
S3_ENDPOINT=https://s3.twcstorage.ru
AWS_DEFAULT_REGION=ru-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Also: scripts/s3-hot.env.example

# Optional: override local media folder (default apps/web/media)
# S3_MEDIA_LOCAL_PATH=apps/web/media
