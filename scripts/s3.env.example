# Copy to scripts/s3.env (gitignored) or export before make s3-sync-*
# S3 Access Key + Secret from Timeweb bucket dashboard (not the Cloud API JWT).

S3_BUCKET=bm-questhub
S3_ENDPOINT=https://s3.twcstorage.ru
AWS_DEFAULT_REGION=ru-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base for NEXT_PUBLIC_S3_PUBLIC_BASE_URL (virtual-hosted style):
# https://bm-questhub.s3.twcstorage.ru

# Optional: override local media folder (default apps/web/media)
# S3_MEDIA_LOCAL_PATH=apps/web/media
