# Copy to scripts/s3.env (gitignored) or: make setup-s3-yc-env
# Active: Yandex bm-questhub — see docs/deployment/s3-storage-migration.md

S3_STORAGE_PROFILE=hot
S3_BUCKET=bm-questhub
S3_LEGACY_BUCKET=bm-quest-s3-hot
S3_LEGACY_ENDPOINT=https://s3.twcstorage.ru
S3_LEGACY_PUBLIC_BASE_URL=https://bm-quest-s3-hot.s3.twcstorage.ru
YCF_PACKAGE_BUCKET=bm-questhub
S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/bm-questhub
S3_ENDPOINT=https://storage.yandexcloud.net
AWS_DEFAULT_REGION=ru-central1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Timeweb rollback: scripts/s3-hot.env.example + make setup-s3-hot-env

# Optional: override local media folder (default apps/web/media)
# S3_MEDIA_LOCAL_PATH=apps/web/media
