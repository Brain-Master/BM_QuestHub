# Design Pack → Google Drive (copy to scripts/design-pack.env, gitignored)
#
# 1. Создайте на Drive папку BM_QuestHub_Media (или используйте существующую).
# 2. В Google Cloud Console того же проекта, что и Sheets API:
#    APIs & Services → Enable APIs → «Google Drive API» → Enable
#    (или откройте ссылку из ошибки publish-design-pack-to-drive)
# 3. Выдайте папку BM_QuestHub_Media доступ Editor сервисному аккаунту (client_email).
# 4. ID папки: из URL https://drive.google.com/drive/folders/FOLDER_ID_HERE
#
# GOOGLE_SERVICE_ACCOUNT_JSON — для SA-режима (тот же, что в scripts/sheets.env); для личного My Drive не нужен — см. OAuth ниже

# Медиа: BM_QuestHub_Media (отдельная папка на Drive)
GOOGLE_MEDIA_DRIVE_FOLDER_ID=

# Данные/инструкции: BM_QuestHub_Data (сосед Media, не внутри Media)
GOOGLE_DATA_DRIVE_FOLDER_ID=

# Подпапка внутри BM_QuestHub_Media — Design Pack (PDF/PSD)
GOOGLE_DESIGN_PACK_DRIVE_SUBFOLDER=FOR_DESIGNER

# Подпапка внутри BM_QuestHub_Media — фото дизайнера
GOOGLE_MEDIA_DRIVE_INBOX_SUBFOLDER=Sync

# Подпапка внутри BM_QuestHub_Data — инструкции (make data-docs-push)
GOOGLE_DATA_EDITORS_SUBFOLDER=FOR_EDITORS

# Режим auth (по умолчанию пусто = oauth-first: token → иначе SA)
# GOOGLE_DRIVE_AUTH=oauth
# GOOGLE_DRIVE_AUTH=service_account

# OAuth (личный Gmail): scripts/design-pack-oauth.env + make design-pack-oauth-login
# SA: папка на **Общем диске** (Shared drive) или Workspace impersonation:
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=you@company.com

# Локальная папка после make design-pack (менять не обязательно)
# DESIGN_PACK_DIST_DIR=dist/design-pack/BM_QuestHub_Design_Pack_v1
